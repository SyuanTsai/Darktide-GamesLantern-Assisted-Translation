{
  "name": "darktide-gameslantern-assisted-translation",
  "version": "0.2.30",
  "private": true,
  "scripts": {
    "build:w01:dev": "node scripts/w01/build-dev-extension.cjs",
    "test:w01:unit": "node --test tests/w01/loader.test.cjs tests/w01/build.test.cjs",
    "test:w01:idb:local": "node --test tests/w01/idb-local.test.cjs",
    "test:w01:idb:extension": "node --test tests/w01/idb-integration.test.cjs",
    "test:w01:renderer": "node --test tests/w01/preview-integration.test.cjs",
    "test:w01:shared-package": "node --test tests/w01/shared-package.test.cjs",
    "test:w01:live-preview": "node --test tests/w01/live-preview.test.cjs",
    "test:w01:pending-preview": "node --test tests/w01/pending-preview-renderer.test.cjs",
    "validate:w02:contract": "node scripts/w02/contract-conformance.mjs",
    "test:w01": "node --test tests/w01/loader.test.cjs tests/w01/build.test.cjs tests/w01/idb-local.test.cjs tests/w01/idb-integration.test.cjs tests/w01/preview-integration.test.cjs tests/w01/shared-package.test.cjs tests/w01/pending-preview-renderer.test.cjs",
    "build:dev": "node scripts/shared/build-dev-extension.cjs",
    "test:w10:unit": "node --test-concurrency=1 --test tests/w10/source-data-contract.test.cjs tests/w10/schema-12.test.cjs tests/w10/source-data-loader.test.cjs tests/w10/source-data-store-update.test.cjs tests/w10/source-data-message-session.test.cjs tests/w10/build.test.cjs",
    "test:w10:idb": "node --test-concurrency=1 --test tests/w10/idb-integration.test.cjs",
    "test:w10:mv3": "node --test-concurrency=1 --test tests/w10/mv3-integration.test.cjs",
    "test:w10": "npm run test:w10:unit && npm run test:w10:idb && npm run test:w10:mv3",
    "test:w11:unit": "node --test --test-concurrency=1 tests/w11/build.test.cjs tests/w11/content-entry.test.cjs tests/w11/message.test.cjs tests/w11/native-identity.test.cjs tests/w11/source-data-display.test.cjs tests/w11/dom-renderer.test.cjs tests/w11/dom-controller.test.cjs",
    "test:w11:dom": "node --test-concurrency=1 --test tests/w11/dom-integration.test.cjs",
    "test:w11:mv3": "node --test-concurrency=1 --test tests/w11/mv3-integration.test.cjs",
    "test:w11": "npm run test:w11:unit && npm run test:w11:dom && npm run test:w11:mv3",
    "icons:w16:render": "node scripts/release/render-icons.cjs",
    "package:w16:release": "node scripts/release/build-production-extension.cjs",
    "test:w16:package": "node --test --test-concurrency=1 tests/w16/production-dataset.test.cjs tests/w16/production-package.test.cjs",
    "test:source-data": "node --test --test-concurrency=1 tests/w10/*.test.cjs tests/w11/*.test.cjs tests/w16/*.test.cjs"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  }
}
